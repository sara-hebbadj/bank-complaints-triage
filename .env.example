# Copy to "Portfolio Projects/.env" (two folders up) or to a local .env in this repo.
# Names only: never commit real values.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_MAIN=
MODEL_CHEAP=
# Must be from a different model family than MODEL_MAIN / MODEL_CHEAP
MODEL_JUDGE=
# Embedding model for the embedding classifier (default: baai/bge-m3, multilingual)
MODEL_EMBED=

# Optional
# Budget guard for evals.run (US$); the run stops when its traced cost passes it (default 2)
MAX_COST_PER_RUN_USD=2
# Hidden "reasoning" effort asked from every chat call: low (default), medium, high, or "default" to send nothing
REASONING_EFFORT=
# Messages per session in the Gradio demo (default 20)
DEMO_MESSAGE_LIMIT=20
# Who uses the agent console (written to the audit log)
REVIEWER_ID=
# Where the demo keeps its queue, audit log and cached model (default: ./runtime)
TRIAGE_RUNTIME_DIR=
